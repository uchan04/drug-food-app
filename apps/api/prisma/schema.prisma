// Drug-Food Interaction Checker - Prisma Schema
// PostgreSQL with pg_trgm extension for fuzzy search

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum AuthProvider {
  email
  google
  kakao
}

enum Language {
  ko
  en
}

enum RiskLevel {
  caution
  warning
  contraindicated
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String
  passwordHash  String?      @map("password_hash")
  provider      AuthProvider @default(email)
  providerId    String?      @map("provider_id")
  language      Language     @default(ko)
  refreshToken  String?      @map("refresh_token")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  medicineBoxItems MedicineBoxItem[]

  // Indexes
  @@unique([provider, providerId])
  @@map("users")
}

// ============================================
// DRUG & INGREDIENTS
// ============================================

model Drug {
  id            String   @id @default(uuid())
  nameKo        String   @map("name_ko")
  nameEn        String   @map("name_en")
  category      String
  descriptionKo String?  @map("description_ko")
  descriptionEn String?  @map("description_en")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  ingredients      DrugIngredient[]
  medicineBoxItems MedicineBoxItem[]

  // Indexes (trigram indexes created via migration SQL)
  @@map("drugs")
}

model DrugIngredient {
  id     String @id @default(uuid())
  drugId String @map("drug_id")
  nameKo String @map("name_ko")
  nameEn String @map("name_en")

  // Relations
  drug         Drug          @relation(fields: [drugId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  // Indexes
  @@index([drugId])
  @@map("drug_ingredients")
}

// ============================================
// FOOD
// ============================================

model Food {
  id        String   @id @default(uuid())
  // 이름이 Food 의 사실상 식별자다. 적재 스크립트가 nameKo 로 찾고, seed 는
  // 안정적인 id 로 넣는다. 제약이 없던 동안 같은 이름의 Food 가 두 행씩 생겨
  // '알코올' 상호작용이 두 묶음으로 쪼개졌다 (마이그레이션 0005).
  nameKo    String   @unique @map("name_ko")
  nameEn    String   @map("name_en")
  category  String
  nutrients String[]
  // 범주 음식의 대표 식품. 식약처 허가사항은 "비타민 K, 지방, 야채류 섭취"처럼
  // 범주로 쓰는데, 사용자는 시금치를 먹을지 말지를 묻는다. 범주 행 하나에
  // 대표 식품을 붙여 두면 출처 있는 근거 하나로 여러 식품을 덮을 수 있다.
  // 개별 음식에는 비어 있다.
  examples  String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  interactions Interaction[]

  @@map("foods")
}

// ============================================
// INTERACTION (Drug-Food)
// ============================================

model Interaction {
  id            String    @id @default(uuid())
  ingredientId  String    @map("ingredient_id")
  foodId        String    @map("food_id")
  riskLevel     RiskLevel @map("risk_level")
  reasonKo      String    @map("reason_ko")
  // 영문과 부작용은 선택이다. 식약처 허가사항은 한국어 원문만 제공하므로
  // 추출한 행에는 이 값이 없다. 의료 정보에서 번역·부작용을 지어내는 것은
  // 빈 값보다 나쁘다. 손으로 적은 seed 행에는 들어 있다.
  reasonEn      String?   @map("reason_en")
  sideEffectsKo String?   @map("side_effects_ko")
  sideEffectsEn String?   @map("side_effects_en")
  timeGapHours  Int?      @map("time_gap_hours")
  createdAt     DateTime  @default(now()) @map("created_at")

  // 출처. 의료 정보라 근거 없는 행이 섞이면 안 된다.
  // 기본값이 seed:manual 인 이유는, 손으로 적은 기존 72행을 숨기지 않고 라벨링하기 위함.
  source    String    @default("seed:manual")
  sourceUrl String?   @map("source_url")
  fetchedAt DateTime? @map("fetched_at")

  // Relations
  ingredient DrugIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  food       Food           @relation(fields: [foodId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([ingredientId, foodId])
  @@index([ingredientId])
  @@index([foodId])
  @@map("interactions")
}

// ============================================
// MEDICINE BOX
// ============================================

model MedicineBoxItem {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  drugId  String   @map("drug_id")
  addedAt DateTime @default(now()) @map("added_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  drug Drug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([userId, drugId])
  @@index([userId])
  @@map("medicine_box_items")
}
