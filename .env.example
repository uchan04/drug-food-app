# ===========================================
# Drug-Food Checker - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# Database
DATABASE_URL="postgresql://dev:dev_password@localhost:5432/drug_food_checker?schema=public&connection_limit=10&pool_timeout=5&connect_timeout=5&statement_timeout=10000"

# Auth - JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Auth - OAuth (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth - OAuth (Kakao)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Environment
NODE_ENV="development"
